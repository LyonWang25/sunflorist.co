---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHead from '../../components/PageHead.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories } from '../../data/categories';
import { breadcrumbJsonLd } from '../../data/jsonld';
import { productImage } from '../../utils/images';
import { formatPrice, getProducts } from '../../utils/products';

// all products, grouped in category order (bouquets → wedding → preserved)
const categoryOrder = categories.filter((c) => !c.consultationOnly).map((c) => c.slug);
const products = (await getProducts()).sort(
  (a, b) =>
    categoryOrder.indexOf(a.data.category) - categoryOrder.indexOf(b.data.category) ||
    a.data.order - b.data.order,
);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Collections', path: '/products/' },
  { name: 'All Products' },
];
---

<Base
  title="All Products | Sun Florist"
  description={`Browse all ${products.length} Sun Florist designs in one place — fresh bouquets, wedding bouquets and preserved florals. Serving DC, MD, VA and NC.`}
  ogImage="/og/collections.jpg"
  jsonLd={breadcrumbJsonLd(crumbs)}
>
  <Nav current="all-products" />
  <main>
    <PageHead
      {crumbs}
      title="All Products"
      lede={`Every design in one place — ${products.length} pieces. Message us your pick.`}
    />

    <div class="container">
      <!-- shown only when JS runs (the filter is client-side) -->
      <div class="product-search" hidden>
        <label class="visually-hidden" for="product-search-input">Search products</label>
        <input
          id="product-search-input"
          type="search"
          placeholder="Search by name or No. — e.g. B-38"
          autocomplete="off"
          spellcheck="false"
        />
        <p class="product-search-status" aria-live="polite"></p>
      </div>

      <div class="product-grid">
        {
          products.map((product, i) => (
            <div data-search={`${product.data.name} ${product.data.no}`}>
              <ProductCard
                name={product.data.name}
                href={`/products/${product.data.slug}/`}
                image={productImage(product.data.images[0]!)}
                imageAlt={product.data.description}
                price={formatPrice(product.data)}
                loading={i < 3 ? 'eager' : 'lazy'}
              />
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Base>

<script>
  // Filter by product name or No. Matching ignores case, accents, spaces and
  // punctuation ("b38", "B-38" and "b 38" all find B-38); every word typed
  // must match. The query is mirrored to ?q= so Back returns to the results.
  const search = document.querySelector<HTMLElement>('.product-search');
  const input = search?.querySelector('input');
  const status = search?.querySelector<HTMLElement>('.product-search-status');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search]'));

  const normalize = (s: string) => s.normalize('NFD').toLowerCase().replace(/[^a-z0-9]/g, '');

  if (search && input && status) {
    const haystacks = items.map((el) => normalize(el.dataset.search ?? ''));

    const apply = () => {
      const query = input.value.trim();
      const terms = query.split(/\s+/).map(normalize).filter(Boolean);
      let shown = 0;
      items.forEach((el, i) => {
        el.hidden = !terms.every((term) => haystacks[i]!.includes(term));
        if (!el.hidden) shown++;
      });

      status.textContent = !terms.length
        ? ''
        : shown
          ? `${shown} of ${items.length} designs`
          : `No designs match “${query}”.`;

      const url = new URL(location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    };

    search.hidden = false;
    input.value = new URLSearchParams(location.search).get('q') ?? input.value;
    input.addEventListener('input', apply);
    apply();
  }
</script>

<style>
  .product-search {
    max-width: 420px;
    margin: 0 auto var(--space-6);
  }

  .product-search input {
    width: 100%;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-body);
    /* 16px keeps iOS Safari from zooming in on focus */
    font-size: 16px;
    -webkit-appearance: none;
    appearance: none;
  }

  .product-search input::placeholder {
    color: var(--color-text-muted);
  }

  .product-search input:hover,
  .product-search input:focus {
    border-color: var(--color-accent);
  }

  .product-search-status {
    min-height: 1.7em;
    margin: var(--space-2) 0 0;
    font-size: 13px;
    color: var(--color-text-muted);
    text-align: center;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-3);
  }

  @media (min-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8) var(--space-6);
    }

    .product-grid :global(.product-card-media) {
      aspect-ratio: auto;
      height: 340px;
    }
  }
</style>
